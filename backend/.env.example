# TeachMate Environment Configuration
PROJECT_NAME="TeachMate"
ENVIRONMENT="development"
DEBUG=true

# Database Connection (PostgreSQL 16)
DATABASE_URL="postgresql+psycopg://localhost:5432/teachmate"

# Security & Sessions
SESSION_SECRET="teachmate-development-secret-key-replace-in-production"

# LLM Configuration (Google Gemini)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
USE_MOCK_LLM=false

# Allowed Frontend Origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
